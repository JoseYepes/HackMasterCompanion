# Finales de línea normalizados en el repositorio
* text=auto
*.sh text eol=lf
*.png binary
*.ico binary
*.woff binary
*.woff2 binary
*.ogg binary
*.mp3 binary

# Datos generados: mismos bytes en Windows y en CI
data/*.json text eol=lf
docs/dudas.md text eol=lf

# Librerías de terceros: se guardan sin tocar, byte a byte (wwwroot/lib/README.md)
src/HackMaster.Web/wwwroot/lib/*.js -text
src/HackMaster.Web/wwwroot/lib/*.LICENSE -text
src/HackMaster.Web/wwwroot/fonts/*.LICENSE -text
src/HackMaster.Web/wwwroot/sounds/*.LICENSE -text
