<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Hoja de estilos que comprueba ThemeContrastTests. -->
  <ItemGroup>
    <None Include="..\..\src\HackMaster.Web\wwwroot\css\app.css" Link="css\app.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\HackMaster.Web\wwwroot\js\dice3d.js" Link="js\dice3d.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\HackMaster.Web\wwwroot\sounds\*" Link="sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Archivos que hacen instalable la aplicación, que comprueba PwaFilesTests (F013). -->
  <ItemGroup>
    <None Include="..\..\src\HackMaster.Web\wwwroot\*.webmanifest;..\..\src\HackMaster.Web\wwwroot\icon-*.png;..\..\src\HackMaster.Web\wwwroot\index.html;..\..\src\HackMaster.Web\wwwroot\service-worker*.js;..\..\src\HackMaster.Web\HackMaster.Web.csproj" Link="pwa\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HackMaster.Web\HackMaster.Web.csproj" />
  </ItemGroup>

</Project>
