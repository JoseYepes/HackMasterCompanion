@* Aviso de las dudas abiertas que afectan a un elemento: duda, fuente y decisión provisional. *@
@foreach (var doubt in Doubts)
{
    <aside class="doubt-notice" data-testid="doubt-notice" role="note">
        <p class="doubt-title">Duda abierta</p>
        <p>@doubt.Question</p>
        @if (!string.IsNullOrWhiteSpace(doubt.Source))
        {
            <p><span class="field-label">Fuente:</span> @doubt.Source</p>
        }
        @if (!string.IsNullOrWhiteSpace(doubt.Provisional))
        {
            <p><span class="field-label">Mientras tanto:</span> @doubt.Provisional</p>
        }
    </aside>
}

@code {
    /// <summary>Dudas que se muestran; ninguna, ningún aviso.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Doubt> Doubts { get; set; } = [];
}
