@* Panel «Aspecto de los dados» (F008, US1): material, colores, efecto al penetrar, sonido y calidad,
   con una vista previa de un dado que gira. El aspecto lo guarda la página (LookChanged). *@
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="dice-look">
    <button type="button" class="dice-look-open" data-testid="look-open" aria-expanded="@(_open ? "true" : "false")"
            aria-controls="dice-look-body" @onclick="ToggleAsync">
        Aspecto de los dados
    </button>
    @if (_open)
    {
        <div id="dice-look-body" class="dice-look-body">
            <div class="dice-look-preview" data-testid="look-preview" @ref="_preview" aria-hidden="true"></div>

            <fieldset class="look-group">
                <legend>Material</legend>
                <div class="look-materials">
                    @foreach (var material in Enum.GetValues<DiceMaterial>())
                    {
                        var current = material;
                        <button type="button" class="look-material" data-testid="look-material-@current"
                                aria-pressed="@(_look.Material == current ? "true" : "false")"
                                @onclick="() => ChangeAsync(_look.ForMaterial(current))">
                            <span class="look-swatch" style="background: @DiceLook.DefaultColors(current).Color"></span>
                            @Names[current]
                        </button>
                    }
                </div>
            </fieldset>

            <div class="look-colors">
                <label for="look-color">Color del dado</label>
                <input id="look-color" type="color" data-testid="look-color" value="@_look.Color"
                       @onchange="args => ChangeColorAsync(args, ink: false)" />
                <label for="look-ink">Color de los números</label>
                <input id="look-ink" type="color" data-testid="look-ink" value="@_look.Ink"
                       @onchange="args => ChangeColorAsync(args, ink: true)" />
            </div>
            @if (_look.InkContrast < 3)
            {
                <p class="look-warning" role="status" data-testid="look-contrast-warning">
                    Con estos colores los números no se leerán bien.
                    <button type="button" data-testid="look-fix-ink" @onclick="() => ChangeAsync(_look with { Ink = _look.ReadableInk() })">
                        Usar números @(_look.ReadableInk() == DiceLook.LightInk ? "claros" : "oscuros")
                    </button>
                </p>
            }

            <fieldset class="look-group">
                <legend>Cuando un dado penetra</legend>
                @foreach (var effect in Enum.GetValues<PenetrationEffect>())
                {
                    var current = effect;
                    <label class="look-choice">
                        <input type="radio" name="look-effect" data-testid="look-effect-@current" checked="@(_look.Effect == current)"
                               @onchange="() => ChangeAsync(_look with { Effect = current })" />
                        @EffectNames[current]
                    </label>
                }
            </fieldset>

            <fieldset class="look-group">
                <legend>Sonido y calidad</legend>
                <label class="look-choice">
                    <input type="checkbox" data-testid="look-sound" checked="@_look.Sound"
                           @onchange="args => ChangeAsync(_look with { Sound = args.Value is true })" />
                    Sonido
                </label>
                @foreach (var quality in Enum.GetValues<DiceQuality>())
                {
                    var current = quality;
                    <label class="look-choice">
                        <input type="radio" name="look-quality" data-testid="look-quality-@current" checked="@(_look.Quality == current)"
                               @onchange="() => ChangeAsync(_look with { Quality = current })" />
                        @(current == DiceQuality.High ? "Calidad alta" : "Calidad baja (móviles lentos)")
                    </label>
                }
            </fieldset>
        </div>
    }
</section>

@code {
    private static readonly Dictionary<DiceMaterial, string> Names = new()
    {
        [DiceMaterial.Ivory] = "Marfil",
        [DiceMaterial.Marble] = "Mármol",
        [DiceMaterial.OldGold] = "Oro viejo",
        [DiceMaterial.BlackIron] = "Hierro negro",
        [DiceMaterial.Ruby] = "Rubí",
        [DiceMaterial.Obsidian] = "Obsidiana",
        [DiceMaterial.Bone] = "Hueso",
        [DiceMaterial.Amethyst] = "Amatista",
        [DiceMaterial.Wood] = "Madera",
        [DiceMaterial.Stone] = "Piedra",
        [DiceMaterial.Crystal] = "Cristal",
    };

    private static readonly Dictionary<PenetrationEffect, string> EffectNames = new()
    {
        [PenetrationEffect.Explosion] = "Explosión",
        [PenetrationEffect.Fire] = "Fuego",
        [PenetrationEffect.Blood] = "Sangre",
        [PenetrationEffect.None] = "Ninguno",
    };

    private DiceLook _look = DiceLook.Default;
    private bool _open;
    private bool _previewPending;
    private ElementReference _preview;
    private IJSObjectReference? _module;

    [Parameter, EditorRequired]
    public DiceLook Look { get; set; } = DiceLook.Default;

    [Parameter]
    public EventCallback<DiceLook> LookChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (Look != _look)
        {
            _look = Look;
            _previewPending = _open;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_previewPending || !_open)
        {
            return;
        }

        _previewPending = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dice3d.js");
            await _module.InvokeVoidAsync("preview", _preview, DiceLookJs.From(_look));
        }
        catch (JSException)
        {
            // Sin vista previa el panel sigue funcionando: el aspecto se ve en la siguiente tirada.
        }
    }

    private async Task ToggleAsync()
    {
        if (_open)
        {
            await StopPreviewAsync();
        }

        _open = !_open;
        _previewPending = _open;
    }

    private async Task ChangeAsync(DiceLook look)
    {
        _look = look;
        _previewPending = _open;
        await LookChanged.InvokeAsync(look);
    }

    private Task ChangeColorAsync(ChangeEventArgs args, bool ink)
    {
        var color = args.Value?.ToString();
        return DiceLook.IsColor(color)
            ? ChangeAsync(ink ? _look with { Ink = color! } : _look with { Color = color! })
            : Task.CompletedTask;
    }

    private async Task StopPreviewAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("stopPreview", _preview);
        }
        catch (JSException)
        {
            // Nada que parar.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            if (_open)
            {
                await _module.InvokeVoidAsync("stopPreview", _preview);
            }

            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // La página se está cerrando.
        }
    }
}
