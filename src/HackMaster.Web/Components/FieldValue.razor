@* Valor de un campo; si está pendiente de verificar, lleva la marca con el texto original de la fuente (FR-027). *@
@if (IsPending)
{
    @if (Text != Display.Missing)
    {
        @Text
        @(" ")
    }
    <PendingMark Raw="@Raw.GetValueOrDefault(Field)" />
}
else
{
    @Text
}

@code {
    /// <summary>Valor ya formateado.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    /// <summary>Nombre del campo en los datos (<c>cost</c>, <c>masteryDie</c>…).</summary>
    [Parameter, EditorRequired]
    public string Field { get; set; } = string.Empty;

    /// <summary>Campos pendientes del elemento.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Pending { get; set; } = [];

    /// <summary>Texto original de la fuente por campo.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string> Raw { get; set; } = new Dictionary<string, string>();

    private bool IsPending => Pending.Contains(Field);
}
