@* Zona de los dados 3D. Importa wwwroot/js/dice3d.js solo cuando se usa (FR-016); contrato en
   specs/004-dados-3d/contracts/dice3d-js.md. El resultado ya viene decidido en el plan. *@
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="dice-board" data-testid="dice-board" title="Toca para terminar la tirada" @ref="_element" @onclick="FinishAsync"></div>

@code {
    private ElementReference _element;
    private IJSObjectReference? _module;
    private bool _created;

    /// <summary>Carga el módulo y crea la mesa. Falso si el navegador no puede mostrar 3D.</summary>
    public async Task<bool> StartAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dice3d.js");
        if (!await _module.InvokeAsync<bool>("isSupported"))
        {
            return false;
        }

        await _module.InvokeVoidAsync("create", _element);
        _created = true;
        return true;
    }

    /// <summary>Tira el plan en pantalla y termina cuando los dados se paran o se llama a <see cref="FinishAsync"/>.</summary>
    public async Task RollAsync(BoardPlan plan)
    {
        if (_module is null || !_created)
        {
            return;
        }

        var dice = plan.Dice.Select(die => new { shape = die.Shape.ToString(), face = die.Face, wave = die.Wave, penetration = die.IsPenetration });
        await _module.InvokeVoidAsync("roll", _element, new { dice });
    }

    /// <summary>Termina al momento la tirada en curso (al tocar la zona o al tirar otra vez).</summary>
    public async Task FinishAsync()
    {
        if (_module is not null && _created)
        {
            await _module.InvokeVoidAsync("finish", _element);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            if (_created)
            {
                await _module.InvokeVoidAsync("dispose", _element);
            }

            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // La página se está cerrando: no queda nada que liberar.
        }
    }
}
