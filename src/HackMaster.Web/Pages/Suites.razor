@page "/conjuntos"
@inject GameData Data
@inject PlayerSuites PlayerSuites
@inject NavigationManager Navigation

<PageTitle>Conjuntos · @AppInfo.Name</PageTitle>

<h1>Conjuntos</h1>

<p><a class="button-link" href="conjuntos/nuevo" data-testid="suite-create">Crear conjunto</a></p>

<PlayerSuitesError />

<div class="search">
    <label for="suite-search">Buscar por nombre</label>
    <input id="suite-search" type="search" autocomplete="off" data-testid="search-input" value="@_text" @oninput="OnSearchInput" />
</div>

<section data-testid="custom-suites">
    <h2>Conjuntos de habilidades (@_custom.Count)</h2>
    <SuiteList Suites="_custom" />
</section>

<section data-testid="official-suites">
    <h2>Conjuntos oficiales (@_official.Count)</h2>
    <SuiteList Suites="_official" />
</section>

@code {
    private const string Path = "conjuntos";

    private string _text = string.Empty;
    private string? _shownUri;
    private IReadOnlyList<SkillSuite> _custom = [];
    private IReadOnlyList<SkillSuite> _official = [];

    /// <summary>Los conjuntos del jugador se leen del dispositivo; al llegar se vuelve a filtrar.</summary>
    protected override async Task OnInitializedAsync()
    {
        await PlayerSuites.LoadAsync();
        Show(_text);
    }

    protected override void OnParametersSet()
    {
        if (Navigation.Uri == _shownUri)
        {
            return;
        }

        _shownUri = Navigation.Uri;
        var uri = new Uri(Navigation.Uri);
        var q = uri.Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .Where(pair => pair[0] == "q" && pair.Length == 2)
            .Select(pair => Uri.UnescapeDataString(pair[1].Replace('+', ' ')))
            .LastOrDefault();
        Show(q ?? string.Empty);
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        Show(args.Value?.ToString() ?? string.Empty);
        var relative = string.IsNullOrWhiteSpace(_text) ? Path : $"{Path}?q={Uri.EscapeDataString(_text)}";
        // AbsoluteUri, no ToString(): el navegador devuelve la dirección codificada ("%C3%A1" por "á"),
        // y la comparación con Navigation.Uri debe hacerse en esa misma forma.
        var uri = Navigation.ToAbsoluteUri(relative).AbsoluteUri;
        if (uri != Navigation.Uri)
        {
            _shownUri = uri;
            Navigation.NavigateTo(uri, replace: true);
        }
    }

    private void Show(string text)
    {
        _text = text;
        var normalized = TextNormalizer.Normalize(text);
        bool Matches(SkillSuite suite) => suite.SearchName.Contains(normalized, StringComparison.Ordinal);
        _custom = PlayerSuites.CustomSuites.Where(Matches).ToList();
        _official = Data.Suites.Where(suite => suite.Kind == SuiteKind.Official && Matches(suite)).ToList();
    }
}
