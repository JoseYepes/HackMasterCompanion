@page "/fichas/nueva"
@page "/fichas/{Id}"
@using System.Globalization
@implements IDisposable
@inject PlayerCharacters PlayerCharacters
@inject IndexedStore Store
@inject GameData Data
@inject NavigationManager Navigation
@inject BrowserStore RollStore
@inject IRandom Random

@if (_notFound)
{
    <NotFound />
}
else
{
    <PageTitle>@Title · @AppInfo.Name</PageTitle>

    <p class="back-link"><a href="fichas">← Fichas</a></p>

    <h1>@Title</h1>

    <CharacterStorageNotice />

    @if (_character is null)
    {
        <p>Cargando…</p>
    }
    else
    {
        <div class="character-form">
            <fieldset class="character-fields">
                <legend>Personaje</legend>
                <label>Nombre <input type="text" autocomplete="off" data-testid="character-name" value="@_character.Name" @oninput="args => Change(_character with { Name = Text(args) ?? string.Empty })" /></label>
                <label>Raza <input type="text" autocomplete="off" data-testid="character-race" value="@_character.Race" @oninput="args => Change(_character with { Race = Text(args) })" /></label>
                <label>Clase <input type="text" autocomplete="off" data-testid="character-class" value="@_character.Class" @oninput="args => Change(_character with { Class = Text(args) })" /></label>
                <label>Nivel <input type="number" inputmode="numeric" min="0" data-testid="character-level" value="@_character.Level" @oninput='args => Change(_character with { Level = Number(args, "level", "Nivel") })' /></label>
                <label>Alineamiento <input type="text" autocomplete="off" data-testid="character-alignment" value="@_character.Alignment" @oninput="args => Change(_character with { Alignment = Text(args) })" /></label>
                <label>PG <input type="number" inputmode="numeric" data-testid="character-hp" value="@_character.HitPoints" @oninput='args => Change(_character with { HitPoints = Number(args, "hp", "PG") })' /></label>
                <label>Honor <input type="number" inputmode="numeric" data-testid="character-honor" value="@_character.Honor" @oninput='args => Change(_character with { Honor = Number(args, "honor", "Honor") })' /></label>
                <label>Dado de Honor
                    <select data-testid="character-honor-die" value="@(_character.HonorDie?.ToString() ?? string.Empty)" @onchange="ChangeHonorDie">
                        <option value="">Sin elegir</option>
                        @foreach (var die in HonorDie.All)
                        {
                            <option value="@die">@die</option>
                        }
                    </select>
                </label>
            </fieldset>

            <fieldset class="character-abilities">
                <legend>Características</legend>
                @foreach (var ability in Enum.GetValues<Ability>())
                {
                    var score = _character.Abilities[ability];
                    var name = AbilityNames[ability];
                    <div class="character-ability">
                        <label for="ability-@ability" title="@name">@ability</label>
                        <input id="ability-@ability" type="number" inputmode="numeric" min="0" aria-label="@name" data-testid="character-ability-@ability"
                               value="@score.Score" @oninput='args => ChangeAbility(ability, _character.Abilities[ability] with { Score = Number(args, $"score-{ability}", name) })' />
                        <span aria-hidden="true">/</span>
                        <input type="number" inputmode="numeric" min="0" max="99" aria-label="Fracción de @name" data-testid="character-fraction-@ability"
                               value="@score.Fraction" @oninput='args => ChangeAbility(ability, _character.Abilities[ability] with { Fraction = Number(args, $"fraction-{ability}", $"Fracción de {name}") })' />
                    </div>
                }
            </fieldset>

            <h2>Habilidades (@_character.Skills.Count)</h2>
            <div class="search">
                <label for="character-skill-search">Añadir habilidades</label>
                <input id="character-skill-search" type="search" autocomplete="off" placeholder="Buscar por nombre" data-testid="character-skill-search"
                       value="@_search" @oninput="args => _search = Text(args) ?? string.Empty" />
            </div>

            @if (SkillResults.Count > 0)
            {
                <ul class="suite-results">
                    @foreach (var skill in SkillResults)
                    {
                        <li data-testid="character-skill-result">
                            <span>@skill.Name</span>
                            <button type="button" aria-label="Añadir @skill.Name" @onclick="() => AddSkill(skill)">Añadir</button>
                        </li>
                    }
                </ul>
            }

            @if (_notice is not null)
            {
                <p class="section-note" role="status">@_notice</p>
            }

            @if (_character.Skills.Count == 0)
            {
                <p class="section-note">Todavía no hay habilidades: búscalas y añádelas.</p>
            }
            else
            {
                <ul class="suite-components character-skills">
                    @for (var i = 0; i < _character.Skills.Count; i++)
                    {
                        var index = i;
                        var skill = _character.Skills[index];
                        var data = Data.FindSkill(skill.Slug);
                        var mastery = Evaluate(skill, data);
                        var masterySides = MasteryDieSides(data);
                        <li data-testid="character-skill">
                            <span class="component-name">
                                @if (data is not null)
                                {
                                    <a href="habilidades/@skill.Slug">@skill.Name</a>
                                }
                                else
                                {
                                    @skill.Name
                                    <span class="pending-reason" data-testid="character-skill-missing"> (no encontrada en los datos)</span>
                                }
                            </span>
                            <span class="skill-mastery" data-testid="character-skill-value">@mastery.Text</span>
                            <span class="skill-breakdown" data-testid="character-skill-breakdown">@mastery.Breakdown</span>

                            <div class="skill-check">
                                <label>Modificador <input type="number" inputmode="numeric" aria-label="Modificador de la prueba de @skill.Name" data-testid="character-skill-modifier"
                                                          value="@_modifiers.GetValueOrDefault(index)" @oninput="args => _modifiers[index] = Modifier(args)" /></label>
                                <button type="button" class="primary" aria-label="Tirar @skill.Name" data-testid="character-skill-check" disabled="@(mastery.Value is null)" @onclick="() => CheckAsync(index)">Tirar</button>
                            </div>
                            @if (_checks.TryGetValue(index, out var check))
                            {
                                <p class="skill-check-result @(check.Succeeded ? "success" : "failure")" role="status" data-testid="character-skill-check-result">
                                    d100: @check.Roll@(check.Modifier == 0 ? "" : $" · modificador {check.Modifier:+0;−0}") · total @check.Total contra @check.Mastery % → <strong>@OutcomeText(check.Outcome)</strong>
                                    @if (_checkErrors.TryGetValue(index, out var checkError))
                                    {
                                        <span class="pending-reason"> (no se guardó en el historial: @checkError)</span>
                                    }
                                </p>
                            }

                            <details class="skill-more">
                                <summary>Mejoras y datos</summary>
                                @if (skill.Improvements.Count > 0)
                                {
                                    <ul class="skill-improvements">
                                        @for (var j = 0; j < skill.Improvements.Count; j++)
                                        {
                                            var improvementIndex = j;
                                            var improvement = skill.Improvements[improvementIndex];
                                            <li data-testid="character-skill-improvement">
                                                <span>+@improvement.Mastery (maestría) +@improvement.Honor (Honor)</span>
                                                <button type="button" aria-label="Quitar la mejora @(improvementIndex + 1) de @skill.Name" data-testid="character-skill-improvement-remove"
                                                        @onclick="() => RemoveImprovement(index, improvementIndex)">Quitar</button>
                                            </li>
                                        }
                                    </ul>
                                }

                                <div class="skill-improve">
                                    <button type="button" data-testid="character-skill-roll-improvement" aria-label="Tirar una mejora de @skill.Name"
                                            disabled="@(_character.HonorDie is null || masterySides is null)" @onclick="() => RollImprovement(index, masterySides!.Value)">Tirar mejora</button>
                                    @if (_character.HonorDie is null)
                                    {
                                        <span class="pending-reason" data-testid="character-skill-roll-note">Elige tu Dado de Honor (arriba) para tirar mejoras.</span>
                                    }
                                    else if (masterySides is null)
                                    {
                                        <span class="pending-reason" data-testid="character-skill-roll-note">El dado de maestría de esta habilidad no se conoce; apunta la mejora a mano.</span>
                                    }
                                    @if (_rolled.TryGetValue(index, out var rolled))
                                    {
                                        <span role="status" data-testid="character-skill-rolled">@rolled</span>
                                    }
                                </div>

                                <div class="skill-improve">
                                    <label>Dado de maestría <input type="number" inputmode="numeric" min="0" aria-label="Tirada del dado de maestría de @skill.Name" data-testid="character-skill-new-mastery"
                                                                   value="@_newImprovements.GetValueOrDefault(index).Mastery" @oninput="args => _newImprovements[index] = _newImprovements.GetValueOrDefault(index) with { Mastery = args.Value?.ToString() }" /></label>
                                    <label>Dado de Honor <input type="number" inputmode="numeric" min="0" aria-label="Tirada del Dado de Honor de @skill.Name" data-testid="character-skill-new-honor"
                                                                value="@_newImprovements.GetValueOrDefault(index).Honor" @oninput="args => _newImprovements[index] = _newImprovements.GetValueOrDefault(index) with { Honor = args.Value?.ToString() }" /></label>
                                    <button type="button" aria-label="Apuntar la mejora de @skill.Name" data-testid="character-skill-add-improvement" @onclick="() => AddImprovement(index)">Apuntar mejora</button>
                                </div>

                                <div class="skill-improve">
                                    <label>Maestría escrita <input type="number" inputmode="numeric" min="0" aria-label="Maestría de @skill.Name" data-testid="character-skill-mastery" value="@skill.Mastery"
                                                                   @oninput='args => ChangeSkill(index, _character.Skills[index] with { Mastery = Number(args, $"mastery-{index}", $"Maestría de {skill.Name}") })' /></label>
                                    <label>Puntos <input type="number" inputmode="numeric" min="0" aria-label="Puntos de @skill.Name" data-testid="character-skill-points" value="@skill.Points"
                                                         @oninput='args => ChangeSkill(index, _character.Skills[index] with { Points = Number(args, $"points-{index}", $"Puntos de {skill.Name}") })' /></label>
                                    <button type="button" aria-label="Quitar @skill.Name" data-testid="character-skill-remove" @onclick="() => RemoveSkill(index)">Quitar habilidad</button>
                                </div>
                            </details>
                        </li>
                    }
                </ul>
            }

            <div class="character-text">
                <label for="character-equipment">Equipo</label>
                <textarea id="character-equipment" rows="4" data-testid="character-equipment" value="@_character.Equipment" @oninput="args => Change(_character with { Equipment = Text(args) })"></textarea>
                <label for="character-notes">Notas</label>
                <textarea id="character-notes" rows="4" data-testid="character-notes" value="@_character.Notes" @oninput="args => Change(_character with { Notes = Text(args) })"></textarea>
            </div>
        </div>

        @if (_problem is not null)
        {
            <p class="dice-error" role="alert" data-testid="character-problem">No se puede guardar: @_problem</p>
        }

        <p class="suite-actions">
            <button type="button" class="primary" data-testid="character-save" disabled="@_busy" @onclick="SaveAsync">Guardar</button>
            @if (Id is not null)
            {
                <button type="button" data-testid="character-export" disabled="@_busy" @onclick="ExportAsync">Exportar</button>
                <button type="button" data-testid="character-duplicate" disabled="@_busy" @onclick="DuplicateAsync">Duplicar</button>
                <button type="button" data-testid="character-delete" disabled="@_busy" @onclick="AskDelete">Borrar</button>
            }
        </p>

        @if (_confirmDelete)
        {
            <div class="doubt-notice" role="alert">
                <p data-testid="character-delete-question">¿Borrar la ficha «@(PlayerCharacters.Find(Id!)?.Name ?? _character.Name)»? No se puede deshacer; si quieres conservarla, expórtala antes.</p>
                <button type="button" data-testid="character-delete-confirm" @ref="_deleteConfirm" @onclick="DeleteAsync">Sí, borrar</button>
                <button type="button" data-testid="character-delete-cancel" @onclick="() => _confirmDelete = false">Cancelar</button>
            </div>
        }
    }
}

@code {
    private const int MaxResults = 12;

    private static readonly Dictionary<Ability, string> AbilityNames = new()
    {
        [Ability.FUE] = "Fuerza",
        [Ability.DES] = "Destreza",
        [Ability.CON] = "Constitución",
        [Ability.INT] = "Inteligencia",
        [Ability.SAB] = "Sabiduría",
        [Ability.CAR] = "Carisma",
        [Ability.ASP] = "Aspecto",
    };

    /// <summary>Campos con un texto que no es un número entero: clave del campo → nombre que se muestra (revisión H7).</summary>
    private readonly Dictionary<string, string> _invalid = new(StringComparer.Ordinal);

    private Character? _character;
    private string? _loadedId;
    private string _search = string.Empty;
    private string? _notice;
    private string? _problem;
    private bool _confirmDelete;
    private bool _focusDelete;
    private bool _notFound;
    private bool _busy;
    private ElementReference _deleteConfirm;

    /// <summary>Ficha que se edita; nulo al crear una nueva.</summary>
    [Parameter]
    public string? Id { get; set; }

    private string Title => Id is null ? "Nueva ficha" : PlayerCharacters.Find(Id)?.Name ?? "Ficha";

    /// <summary>Habilidades cuyo nombre contiene lo buscado, sin acentos ni mayúsculas (FR-003).</summary>
    private IReadOnlyList<Skill> SkillResults
    {
        get
        {
            var text = TextNormalizer.Normalize(_search);
            return text.Length == 0 ? [] : [.. Data.Skills.Where(skill => skill.SearchName.Contains(text, StringComparison.Ordinal)).Take(MaxResults)];
        }
    }

    /// <summary>Lo que impide guardar o exportar lo que hay en pantalla, o nulo.</summary>
    private string? Problem =>
        _invalid.Count > 0 ? $"«{_invalid.Values.First()}» debe ser un número entero." : _character!.Problems().FirstOrDefault();

    protected override void OnInitialized() => Store.AvailabilityChanged += OnAvailabilityChanged;

    /// <summary>
    /// Carga la ficha cada vez que cambia la dirección (por ejemplo, al abrir la copia recién hecha).
    /// Una ficha nueva recibe aquí su identificador, para que pulsar dos veces «Guardar» no cree dos.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_character is not null && _loadedId == Id)
        {
            return;
        }

        await PlayerCharacters.LoadAsync();
        _loadedId = Id;
        _search = string.Empty;
        _notice = null;
        _problem = null;
        _confirmDelete = false;
        _notFound = false;
        _invalid.Clear();
        if (Id is null)
        {
            var now = DateTimeOffset.Now;
            _character = new Character { Id = Guid.NewGuid().ToString("N"), Name = string.Empty, CreatedAt = now, UpdatedAt = now };
        }
        else if (PlayerCharacters.Find(Id) is { } saved)
        {
            _character = saved;
        }
        else
        {
            _character = null;
            _notFound = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDelete && _confirmDelete)
        {
            _focusDelete = false;
            await _deleteConfirm.FocusAsync();
        }
    }

    private static string? Text(ChangeEventArgs args) => args.Value?.ToString() is { Length: > 0 } text ? text : null;

    /// <summary>El número escrito, o nulo si está vacío; si no es un entero, lo apunta como problema.</summary>
    private int? Number(ChangeEventArgs args, string key, string label)
    {
        var text = args.Value?.ToString()?.Trim();
        _invalid.Remove(key);
        if (string.IsNullOrEmpty(text))
        {
            return null;
        }

        if (int.TryParse(text, NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var value))
        {
            return value;
        }

        _invalid[key] = label;
        return null;
    }

    private void Change(Character character)
    {
        _character = character;
        _problem = null;
    }

    private void ChangeAbility(Ability ability, AbilityScore score) => Change(_character! with { Abilities = _character.Abilities.With(ability, score) });

    /// <summary>Cambia la habilidad de esa posición (por posición: un archivo puede traer dos iguales).</summary>
    private void ChangeSkill(int index, CharacterSkill changed) =>
        Change(_character! with { Skills = [.. _character.Skills.Select((skill, i) => i == index ? changed : skill)] });

    private void AddSkill(Skill skill)
    {
        if (_character!.Skills.Any(existing => existing.Slug == skill.Slug))
        {
            _notice = $"«{skill.Name}» ya está en la ficha.";
            return;
        }

        Change(_character with { Skills = [.. _character.Skills, new CharacterSkill(skill.Slug, skill.Name)] });
        _notice = null;
        _search = string.Empty;
    }

    private void RemoveSkill(int index)
    {
        // Las claves de las habilidades van por posición: al quitar una, dejan de corresponder.
        foreach (var key in _invalid.Keys.Where(key => key.StartsWith("mastery-", StringComparison.Ordinal) || key.StartsWith("points-", StringComparison.Ordinal)).ToList())
        {
            _invalid.Remove(key);
        }

        _modifiers.Clear();
        _checks.Clear();
        _checkErrors.Clear();
        _rolled.Clear();
        _newImprovements.Clear();
        Change(_character! with { Skills = [.. _character.Skills.Where((_, i) => i != index)] });
    }

    /// <summary>Lo que se escribe en «Apuntar mejora» antes de pulsar el botón.</summary>
    private readonly record struct NewImprovement(string? Mastery, string? Honor);

    /// <summary>Maestría que se muestra: el valor (nulo si no se puede calcular), el texto y el desglose.</summary>
    private sealed record MasteryView(int? Value, string Text, string Breakdown);

    private readonly Dictionary<int, int> _modifiers = [];
    private readonly Dictionary<int, SkillCheck> _checks = [];
    private readonly Dictionary<int, string> _checkErrors = [];
    private readonly Dictionary<int, string> _rolled = [];
    private readonly Dictionary<int, NewImprovement> _newImprovements = [];

    /// <summary>
    /// Maestría de una habilidad (F005, MJ p. 100–101 y 307): la escrita a mano si la hay; si no, la
    /// característica relevante más las mejoras, con tope de 125 %.
    /// </summary>
    private MasteryView Evaluate(CharacterSkill skill, Skill? data)
    {
        var improvements = skill.Improvements.Sum(improvement => improvement.Total);
        if (skill.Mastery is { } written)
        {
            return new MasteryView(written, WithLevel(written), "escrita a mano (bórrala en «Mejoras y datos» para calcularla)");
        }

        if (data is null)
        {
            return new MasteryView(null, "pendiente: la habilidad ya no está en los datos", "escribe la maestría a mano");
        }

        var abilities = string.Join(", ", data.Abilities);
        if (SkillRules.BaseMastery(data.Abilities, _character!.Abilities) is not { } baseMastery)
        {
            return new MasteryView(null, data.Abilities.Count == 0 ? "pendiente: la habilidad no tiene característica" : $"pendiente: falta {abilities}", "rellena las características");
        }

        var mastery = SkillRules.Mastery(data.Abilities, _character.Abilities, skill.Improvements)!.Value;
        var source = data.Abilities.Count == 1 ? $"{abilities} {baseMastery}" : $"media de {abilities}: {baseMastery}";
        var capped = baseMastery + improvements > SkillRules.MaxMastery ? $" (tope de {SkillRules.MaxMastery} %)" : string.Empty;
        return new MasteryView(mastery, WithLevel(mastery), $"{source} + mejoras {improvements}{capped}");
    }

    private static string WithLevel(int mastery) => $"{mastery} % · {SkillRules.LevelName(SkillRules.Level(mastery))}";

    /// <summary>Caras del dado de maestría de la habilidad («d8» → 8), o nulo si no es un dado.</summary>
    private static int? MasteryDieSides(Skill? data) =>
        data?.MasteryDie is { Length: > 1 } die && die[0] == 'd' && int.TryParse(die[1..], NumberStyles.None, CultureInfo.InvariantCulture, out var sides) && sides >= 2
            ? sides
            : null;

    private static int Modifier(ChangeEventArgs args) =>
        int.TryParse(args.Value?.ToString(), NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var value) ? value : 0;

    private static string OutcomeText(SkillCheckOutcome outcome) => outcome switch
    {
        SkillCheckOutcome.Success => "Éxito",
        SkillCheckOutcome.AutomaticSuccess => "Éxito automático (01–05)",
        SkillCheckOutcome.AutomaticFailure => "Fallo automático (98–00)",
        _ => "Fallo",
    };

    private void ChangeHonorDie(ChangeEventArgs args) =>
        Change(_character! with { HonorDie = HonorDie.TryParse(args.Value?.ToString(), out var die) ? die : null });

    private void AddImprovementTo(int index, SkillImprovement improvement) =>
        ChangeSkill(index, _character!.Skills[index] with { Improvements = [.. _character.Skills[index].Improvements, improvement] });

    /// <summary>Tira el dado de maestría y el Dado de Honor y suma la mejora (MJ p. 101).</summary>
    private void RollImprovement(int index, int masterySides)
    {
        var honorDie = _character!.HonorDie!;
        var improvement = SkillRules.RollImprovement(masterySides, honorDie, Random);
        AddImprovementTo(index, improvement);
        _rolled[index] = $"Mejora tirada: d{masterySides}: {improvement.Mastery} + {honorDie}: {improvement.Honor} = +{improvement.Total}. Guarda la ficha para conservarla.";
    }

    /// <summary>Apunta una mejora tirada con dados físicos.</summary>
    private void AddImprovement(int index)
    {
        var typed = _newImprovements.GetValueOrDefault(index);
        if (!int.TryParse(typed.Mastery, NumberStyles.None, CultureInfo.InvariantCulture, out var mastery)
            || !int.TryParse(typed.Honor, NumberStyles.None, CultureInfo.InvariantCulture, out var honor))
        {
            _rolled[index] = "Escribe las dos tiradas (dado de maestría y Dado de Honor) como números enteros.";
            return;
        }

        AddImprovementTo(index, new SkillImprovement(mastery, honor));
        _newImprovements.Remove(index);
        _rolled.Remove(index);
    }

    private void RemoveImprovement(int index, int improvementIndex) =>
        ChangeSkill(index, _character!.Skills[index] with { Improvements = [.. _character.Skills[index].Improvements.Where((_, i) => i != improvementIndex)] });

    /// <summary>Prueba de habilidad (MJ p. 100 y 356); la tirada se guarda en el historial del tirador.</summary>
    private async Task CheckAsync(int index)
    {
        var skill = _character!.Skills[index];
        if (Evaluate(skill, Data.FindSkill(skill.Slug)).Value is not { } mastery)
        {
            return;
        }

        var (roll, check) = SkillRules.RollCheck(mastery, _modifiers.GetValueOrDefault(index), Random, DateTimeOffset.Now);
        _checks[index] = check;
        _checkErrors.Remove(index);
        var (_, error) = await RollHistoryUpdate.ApplyAsync(RollStore, RollHistoryFile.Empty, history => RollHistory.Add(history, roll));
        if (error is not null)
        {
            _checkErrors[index] = error;
        }
    }

    private void AskDelete()
    {
        _confirmDelete = true;
        _focusDelete = true;
    }

    /// <summary>Lo que hay en pantalla, listo para guardar, o nulo con <see cref="_problem"/> puesto.</summary>
    private Character? Ready()
    {
        _problem = Problem;
        return _problem is null ? _character! with { Name = _character.Name.Trim() } : null;
    }

    private async Task<bool> SaveCurrentAsync()
    {
        if (Ready() is not { } character)
        {
            return false;
        }

        character = character with { UpdatedAt = DateTimeOffset.Now };
        _problem = await PlayerCharacters.SaveAsync(character, Id is null ? SaveMode.Create : SaveMode.Update);
        if (_problem is null)
        {
            _character = character;
        }

        return _problem is null;
    }

    private async Task SaveAsync() => await BusyAsync(async () =>
    {
        if (await SaveCurrentAsync())
        {
            Navigation.NavigateTo("fichas");
        }
    });

    /// <summary>Exporta lo que hay en pantalla, aunque no se haya guardado todavía (revisión H4).</summary>
    private async Task ExportAsync() => await BusyAsync(async () =>
    {
        if (Ready() is { } character)
        {
            _problem = await PlayerCharacters.ExportAsync(character);
        }
    });

    /// <summary>Guarda los cambios de la pantalla y luego copia la ficha (revisión H4).</summary>
    private async Task DuplicateAsync() => await BusyAsync(async () =>
    {
        if (!IsSaved() && !await SaveCurrentAsync())
        {
            return;
        }

        var (copy, problem) = await PlayerCharacters.DuplicateAsync(Id!, Guid.NewGuid().ToString("N"), DateTimeOffset.Now);
        _problem = problem;
        if (copy is not null)
        {
            Navigation.NavigateTo($"fichas/{Uri.EscapeDataString(copy.Id)}");
        }
    });

    private bool IsSaved() =>
        _invalid.Count == 0 && PlayerCharacters.Find(Id!) is { } saved && saved.HasSameData(_character!);

    private async Task DeleteAsync() => await BusyAsync(async () =>
    {
        _problem = await PlayerCharacters.DeleteAsync(Id!);
        _confirmDelete = false;
        if (_problem is null)
        {
            Navigation.NavigateTo("fichas");
        }
    });

    /// <summary>Hace la acción con los botones desactivados, para que un doble clic no la repita.</summary>
    private async Task BusyAsync(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnAvailabilityChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.AvailabilityChanged -= OnAvailabilityChanged;
}
