@page "/invitaciones"
@implements IDisposable
@inject IServiceProvider Services

<PageTitle>Invitaciones · @AppInfo.Name</PageTitle>

<h1>Invitaciones</h1>

@if (_sync is null || _sync.State != AccountState.SignedIn || !_sync.IsAdmin)
{
    <p data-testid="invitations-denied">Solo quien administra la aplicación puede ver las invitaciones.</p>
}
else
{
    <p>Solo las personas con un correo invitado pueden crear cuenta e iniciar sesión.</p>

    <form class="invite-form" @onsubmit="InviteAsync">
        <label for="invite-email">Correo</label>
        <input id="invite-email" type="email" data-testid="invite-email" autocomplete="off" @bind="_email" @bind:event="oninput" />
        <div class="suite-actions">
            <button type="submit" class="primary" data-testid="invite" disabled="@(_busy || string.IsNullOrWhiteSpace(_email))">Invitar</button>
        </div>
    </form>

    @if (_invitations is null)
    {
        <p role="status">Cargando…</p>
    }
    else if (_invitations.Count == 0)
    {
        <p data-testid="invitations-empty">Aún no has invitado a nadie.</p>
    }
    else
    {
        <ul class="invitation-list" data-testid="invitation-list">
            @foreach (var invitation in _invitations)
            {
                <li>
                    <span class="invitation-email">@invitation.Email</span>
                    <button type="button" class="account-button" data-testid="uninvite" disabled="@_busy" @onclick="() => UninviteAsync(invitation.Email)">Quitar</button>
                </li>
            }
        </ul>
    }
}

@if (_message is not null)
{
    <p role="status" data-testid="invitations-message">@_message</p>
}

@code {
    private IAccountSync? _sync;
    private IReadOnlyList<InvitationInfo>? _invitations;
    private string _email = "";
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _sync = Services.GetService(typeof(IAccountSync)) as IAccountSync;
        if (_sync is null)
        {
            return;
        }

        _sync.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_sync is not { State: AccountState.SignedIn, IsAdmin: true })
        {
            return;
        }

        _invitations = await _sync.ListInvitationsAsync();
        if (_invitations is null)
        {
            _message = "No se ha podido conectar con la cuenta. Inténtalo más tarde.";
            _invitations = [];
        }
    }

    private async Task InviteAsync()
    {
        _busy = true;
        var email = _email.Trim();
        _message = await _sync!.InviteAsync(email);
        if (_message is null)
        {
            _message = $"Invitado: {email}.";
            _email = "";
            await LoadAsync();
        }

        _busy = false;
    }

    private async Task UninviteAsync(string email)
    {
        _busy = true;
        _message = await _sync!.UninviteAsync(email) ?? $"Invitación quitada: {email}.";
        await LoadAsync();
        _busy = false;
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        if (_invitations is null)
        {
            await LoadAsync();
        }

        StateHasChanged();
    });

    public void Dispose()
    {
        if (_sync is not null)
        {
            _sync.Changed -= OnChanged;
        }
    }
}
