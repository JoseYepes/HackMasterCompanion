@inherits LayoutComponentBase
@implements IDisposable
@inject GameData Data
@inject BrowserStore Store

<header class="site-header">
    <a class="site-name" href="">@AppInfo.Name</a>
    <nav class="site-nav" aria-label="Secciones">
        <NavLink href="habilidades">Habilidades</NavLink>
        <NavLink href="conjuntos">Conjuntos</NavLink>
        <NavLink href="estilos">Estilos</NavLink>
        <NavLink href="grimorio">Grimorio</NavLink>
        <NavLink href="dudas">Dudas</NavLink>
        <NavLink href="dados">Dados</NavLink>
        <NavLink href="fichas">Fichas</NavLink>
    </nav>
    <ThemeToggle />
</header>

@if (!Store.IsAvailable)
{
    <p class="storage-warning" role="status" data-testid="storage-warning">
        El navegador no deja guardar datos: tus conjuntos y tiradas no se pueden guardar y se
        perderán al cerrar la página.
    </p>
}

<main>
    @if (Data.LoadError is not null)
    {
        <h1>No se pudieron cargar los datos</h1>
        <p role="alert">@Data.LoadError</p>
    }
    else
    {
        @Body
    }
</main>

@code {
    protected override void OnInitialized() => Store.AvailabilityChanged += OnAvailabilityChanged;

    private void OnAvailabilityChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.AvailabilityChanged -= OnAvailabilityChanged;
}
